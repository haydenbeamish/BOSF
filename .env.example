# Backend API base URL (defaults to /api/competition if not set)
VITE_API_URL=/api/competition

# API key for backend authentication (optional)
VITE_LASERBEAMNODE_API_KEY=

# Fireworks API key for AI banter and chat (server-side). No value here.
FIREWORKS_API_KEY=

# Fireworks model for /api/ai/banter and /api/ai/chat.
# Default accounts/fireworks/models/glm-5p2. Do not set glm-4p7.
FIREWORKS_BANTER_MODEL=accounts/fireworks/models/glm-5p2

# Optional. Default is https://api.fireworks.ai/inference/v1
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Brave Web Search API key for event news (server-side)
BRAVE_WEBSEARCH_API=
