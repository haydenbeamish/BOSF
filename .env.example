# Backend API base URL (defaults to /api/competition if not set)
VITE_API_URL=/api/competition

# API key for backend authentication (optional)
VITE_LASERBEAMNODE_API_KEY=

# OpenRouter API key for AI banter generation (server-side)
OPENROUTER_API_KEY=

# OpenRouter model for newsfeed banter + /api/ai/chat.
# Default is z-ai/glm-4.7 (cheap, swears). Do not use x-ai/grok-4.6 here.
# Dirt cheap fallback: z-ai/glm-4.7-flash
OPENROUTER_BANTER_MODEL=z-ai/glm-4.7

# Brave Web Search API key for event news (server-side)
BRAVE_WEBSEARCH_API=
